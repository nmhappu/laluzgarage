# ------------------------------------------------------------------------------
# Server / Container Configuration
# ------------------------------------------------------------------------------
# Port on which the container/server listens (default: 2266)
PORT=2266

# Hostname for Nginx web server configuration (default: localhost)
SERVER_NAME=localhost

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration (Required)
# ------------------------------------------------------------------------------
# These credentials can be found in the Firebase Console:
# Project Settings > General > Your apps > Web app > SDK setup and configuration
#
# Note: In container environments, either VITE_FIREBASE_* or FIREBASE_* format
# is supported and injected automatically at runtime.

# Web API Key
VITE_FIREBASE_API_KEY=your_api_key

# Firebase Auth Domain (e.g. your-project.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

# Firebase Project ID
VITE_FIREBASE_PROJECT_ID=your_project_id

# Cloud Storage Bucket URL (e.g. your-project.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# Firebase Cloud Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase Web Application ID
VITE_FIREBASE_APP_ID=your_app_id

# Firestore Database ID (Optional; default is '(default)')
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Set to 'true' if you need to disable Hot Module Replacement during Vite dev
# DISABLE_HMR=false
