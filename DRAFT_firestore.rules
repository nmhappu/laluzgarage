rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validations ---

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'phone', 'technicianId', 'createdAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.technicianId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['customerId', 'make', 'plateNumber', 'technicianId', 'createdAt']) &&
             data.customerId is string &&
             data.make is string && data.make.size() <= 50 &&
             data.plateNumber is string && data.plateNumber.size() <= 20 &&
             data.technicianId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidPart(data) {
      return data.keys().hasAll(['name', 'sku', 'stockQuantity', 'price']) &&
             data.name is string && data.name.size() <= 100 &&
             data.sku is string && data.sku.size() <= 50 &&
             data.stockQuantity is int &&
             data.price is number;
    }

    function isValidServiceRecord(data) {
      return data.keys().hasAll(['vehicleId', 'customerId', 'technicianId', 'date', 'description', 'status', 'laborCost', 'partsCost', 'totalCost', 'createdAt', 'updatedAt']) &&
             data.vehicleId is string &&
             data.customerId is string &&
             data.technicianId == request.auth.uid &&
             data.status in ['pending', 'in-progress', 'completed', 'cancelled'] &&
             data.laborCost is number &&
             data.partsCost is number &&
             data.totalCost is number &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidWorkshopUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'status', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['admin', 'manager', 'technician'] &&
             data.status in ['online', 'offline'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidWorkshopUser(incoming());
      allow update: if isSignedIn() && (
        // Only allow status updates or profile updates by the user themselves
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().updatedAt == request.time) ||
        // Admin can update roles
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidCustomer(incoming());
      allow update: if isSignedIn() && isValidCustomer(incoming());
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidVehicle(incoming());
      allow update: if isSignedIn() && isValidVehicle(incoming());
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /parts/{partId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPart(incoming());
      allow update: if isSignedIn() && (
        // Standard part update
        isValidPart(incoming()) ||
        // Partial update for stock levels
        incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity'])
      );
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /serviceRecords/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidServiceRecord(incoming());
      allow update: if isSignedIn() && (
        isValidServiceRecord(incoming()) && (
          // Tech can update status
          incoming().diff(existing()).affectedKeys().hasAny(['status', 'description', 'remarks', 'updatedAt']) ||
          // Admin can update everything
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
