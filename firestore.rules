rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['pncsns8194@gmail.com', 'me@appu.dev', 'appu@appu.dev', 'aswalal@laluz.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isManager() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager')
      );
    }

    function isVerified() {
      // Relaxed for development to allow unverified emails from the workshop domain or known users
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.email in ['pncsns8194@gmail.com', 'me@appu.dev', 'appu@appu.dev', 'aswalal@laluz.com'] ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validations ---

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'phone', 'technicianId', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 20 &&
             data.technicianId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['customerId', 'make', 'plateNumber', 'technicianId', 'createdAt']) &&
             data.customerId is string && isValidId(data.customerId) &&
             data.make is string && data.make.size() > 0 && data.make.size() <= 50 &&
             data.plateNumber is string && data.plateNumber.size() > 0 && data.plateNumber.size() <= 20 &&
             data.technicianId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidPart(data) {
      return data.keys().hasAll(['name', 'sku', 'stockQuantity', 'price']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.sku is string && data.sku.size() > 0 && data.sku.size() <= 50 &&
             data.stockQuantity is int && data.stockQuantity >= 0 &&
             data.price is number && data.price >= 0;
    }

    function isValidServiceRecord(data) {
      return data.keys().hasAll(['vehicleId', 'customerId', 'technicianId', 'date', 'description', 'status', 'laborCost', 'partsCost', 'totalCost', 'createdAt', 'updatedAt']) &&
             data.vehicleId is string && isValidId(data.vehicleId) &&
             data.customerId is string && isValidId(data.customerId) &&
             data.technicianId == request.auth.uid &&
             data.status in ['pending', 'in-progress', 'completed', 'cancelled'] &&
             data.laborCost is number && data.laborCost >= 0 &&
             data.partsCost is number && data.partsCost >= 0 &&
             data.totalCost is number && data.totalCost >= 0 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidWorkshopUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'status', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.role in ['admin', 'manager', 'technician'] &&
             data.status in ['online', 'offline'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidWorkshopUser(incoming()) && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || isAdmin()
      );
      allow update: if isVerified() && isValidWorkshopUser(incoming()) && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidCustomer(incoming());
      allow update: if isVerified() && isValidCustomer(incoming());
      allow delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidVehicle(incoming());
      allow update: if isVerified() && isValidVehicle(incoming());
      allow delete: if isAdmin();
    }

    match /parts/{partId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isManager() && isValidPart(incoming());
      allow update: if isVerified() && (
        isValidPart(incoming()) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity'])
      );
      allow delete: if isAdmin();
    }

    match /serviceRecords/{recordId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidServiceRecord(incoming());
      allow update: if isVerified() && (
        isAdmin() || (existing().technicianId == request.auth.uid && existing().status != 'completed')
      );
      allow delete: if isAdmin();
    }

    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
