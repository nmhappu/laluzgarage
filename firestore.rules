rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return hasUserDoc() ? (
        ('role' in getUserData() && getUserData().role is string) ? getUserData().role :
        ('tags' in getUserData() && getUserData().tags is list && 'admin' in getUserData().tags) ? 'admin' :
        ('tags' in getUserData() && getUserData().tags is list && ('tech' in getUserData().tags || 'technician' in getUserData().tags)) ? 'technician' :
        ('tags' in getUserData() && getUserData().tags is list && 'assistant' in getUserData().tags) ? 'assistant' :
        'unassigned'
      ) : 'unassigned';
    }

    function isBootstrapAllowed() {
      return !exists(/databases/$(database)/documents/settings/admin_lock);
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && 'admin' in request.auth.token && request.auth.token.admin == true) ||
        (getUserRole() == 'admin')
      );
    }

    function isTechnician() {
      return isAdmin() || (getUserRole() == 'technician');
    }

    function isAssistant() {
      return getUserRole() == 'assistant';
    }

    function hasActiveRole() {
      return isAdmin() || isTechnician() || isAssistant();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validations ---
    function isImmutable(field) {
      return !(field in incoming().keys()) || !(field in existing().keys()) || incoming()[field] == existing()[field];
    }

    function isRoleUnchanged() {
      return (!('role' in incoming().keys()) && !('role' in existing().keys())) ||
             (('role' in incoming().keys()) && ('role' in existing().keys()) && incoming().role == existing().role);
    }

    function isTagsUnchanged() {
      return (!('tags' in incoming().keys()) && !('tags' in existing().keys())) ||
             (('tags' in incoming().keys()) && ('tags' in existing().keys()) && incoming().tags == existing().tags);
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'phone', 'technicianId', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['customerId', 'make', 'plateNumber', 'technicianId', 'createdAt']) &&
             data.customerId is string && isValidId(data.customerId) &&
             data.make is string && data.make.size() > 0 && data.make.size() <= 50 &&
             data.plateNumber is string && data.plateNumber.size() > 0 && data.plateNumber.size() <= 30;
    }

    function isValidPart(data) {
      return data.keys().hasAll(['name', 'stockQuantity', 'price']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('sku' in data.keys()) || data.sku == null || (data.sku is string && data.sku.size() <= 50)) &&
             data.stockQuantity is int && data.stockQuantity >= 0 &&
             data.price is number && data.price >= 0;
    }

    function isValidServiceRecord(data) {
      return data.keys().hasAll(['vehicleId', 'customerId', 'technicianId', 'date', 'description', 'status', 'laborCost', 'partsCost', 'totalCost', 'createdAt', 'updatedAt']) &&
             data.vehicleId is string && isValidId(data.vehicleId) &&
             data.customerId is string && isValidId(data.customerId) &&
             data.status in ['pending', 'in-progress', 'completed', 'cancelled'] &&
             data.laborCost is number && data.laborCost >= 0 &&
             data.partsCost is number && data.partsCost >= 0 &&
             data.totalCost is number && data.totalCost >= 0 &&
             (!('remarks' in data.keys()) || data.remarks == null || (data.remarks is string && data.remarks.size() <= 2000)) &&
             (!('finalRemarks' in data.keys()) || data.finalRemarks == null || (data.finalRemarks is string && data.finalRemarks.size() <= 2000));
    }

    function isValidWorkshopUser(data) {
      return data.keys().hasAll(['name', 'email', 'status', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.status in ['online', 'offline'] &&
             (!('role' in data.keys()) || data.role == null || data.role in ['admin', 'technician', 'assistant']) &&
             (!('pin' in data.keys()) || data.pin == null || (data.pin is string && data.pin.size() <= 10)) &&
             (!('tags' in data.keys()) || (data.tags is list && (data.tags.size() == 0 || (data.tags.size() > 0 && data.tags[0] is string))));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidWorkshopUser(incoming()) &&
                    (request.auth.uid == userId || isAdmin()) &&
                    (isAdmin() || isBootstrapAllowed() || ((!('role' in incoming().keys()) || incoming().role != 'admin') && (!('tags' in incoming().keys()) || !('admin' in incoming().tags)))) &&
                    (incoming().createdAt == request.time || incoming().createdAt is timestamp || incoming().createdAt is string) &&
                    (incoming().updatedAt == request.time || incoming().updatedAt is timestamp || incoming().updatedAt is string);
      allow update: if isSignedIn() && isValidWorkshopUser(incoming()) && isImmutable('createdAt') &&
                    (isAdmin() ||
                     (request.auth.uid == userId && isRoleUnchanged() && isTagsUnchanged()) ||
                     (isBootstrapAllowed() && request.auth.uid == userId)) &&
                    (incoming().updatedAt == request.time || incoming().updatedAt is timestamp || incoming().updatedAt is string);
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /customers/{customerId} {
      allow read: if hasActiveRole();
      allow create: if (isTechnician() || isAssistant()) && isValidCustomer(incoming());
      allow update: if isTechnician() && isValidCustomer(incoming()) && isImmutable('createdAt');
      allow delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if hasActiveRole();
      allow create: if (isTechnician() || isAssistant()) && isValidVehicle(incoming());
      allow update: if isTechnician() && isValidVehicle(incoming()) && isImmutable('createdAt');
      allow delete: if isAdmin();
    }

    match /parts/{partId} {
      allow read: if hasActiveRole();
      allow create, update: if isTechnician() && isValidPart(incoming());
      allow delete: if isAdmin();
    }

    match /serviceRecords/{recordId} {
      allow read: if hasActiveRole();
      allow create: if (isTechnician() || isAssistant()) && isValidServiceRecord(incoming());
      allow update: if isTechnician() && isValidServiceRecord(incoming()) && isImmutable('createdAt');
      allow delete: if isAdmin();
    }

    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if hasActiveRole();
      allow write: if isAdmin() || (settingId == 'admin_lock' && isBootstrapAllowed());
    }
  }
}
