{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "test": "vitest run src/lib/",
    "lint": "eslint . && tsc --noEmit",
    "docker:build": "docker build -t laluzgarage .",
    "docker:run": "docker run -p 2266:2266 --env-file .env laluzgarage",
